{
  "_comment": "MC68000 instruction timing table. Times in cycles. Sourced from docs/68000_execution_cycles.md",
  "_note": "On ST at 8MHz, round to multiples of 4 (10→12). b/w means .b or .w size, l means .l",

  "move": {
    "_comment": "MOVE matrix: src → dst timings as [b/w, l]",
    "dn": {
      "dn": [4, 4], "an": [4, 4], "(an)": [8, 12], "(an)+": [8, 12], "-(an)": [8, 14],
      "d(an)": [12, 16], "d(an,ri)": [14, 18], "abs.w": [12, 16], "abs.l": [16, 20]
    },
    "an": {
      "dn": [4, 4], "an": [4, 4], "(an)": [8, 12], "(an)+": [8, 12], "-(an)": [8, 14],
      "d(an)": [12, 16], "d(an,ri)": [14, 18], "abs.w": [12, 16], "abs.l": [16, 20]
    },
    "(an)": {
      "dn": [8, 12], "an": [8, 12], "(an)": [12, 20], "(an)+": [12, 20], "-(an)": [12, 20],
      "d(an)": [16, 24], "d(an,ri)": [18, 26], "abs.w": [16, 24], "abs.l": [20, 28]
    },
    "(an)+": {
      "dn": [8, 12], "an": [8, 12], "(an)": [12, 20], "(an)+": [12, 20], "-(an)": [12, 20],
      "d(an)": [16, 24], "d(an,ri)": [18, 26], "abs.w": [16, 24], "abs.l": [20, 28]
    },
    "-(an)": {
      "dn": [10, 14], "an": [10, 14], "(an)": [14, 22], "(an)+": [14, 22], "-(an)": [14, 22],
      "d(an)": [18, 26], "d(an,ri)": [20, 28], "abs.w": [18, 26], "abs.l": [22, 30]
    },
    "d(an)": {
      "dn": [12, 16], "an": [12, 16], "(an)": [16, 24], "(an)+": [16, 24], "-(an)": [16, 24],
      "d(an)": [20, 28], "d(an,ri)": [22, 30], "abs.w": [20, 28], "abs.l": [24, 32]
    },
    "d(an,ri)": {
      "dn": [14, 18], "an": [14, 18], "(an)": [18, 26], "(an)+": [18, 26], "-(an)": [18, 26],
      "d(an)": [22, 30], "d(an,ri)": [24, 32], "abs.w": [22, 30], "abs.l": [26, 34]
    },
    "abs.w": {
      "dn": [12, 16], "an": [12, 16], "(an)": [16, 24], "(an)+": [16, 24], "-(an)": [16, 24],
      "d(an)": [20, 28], "d(an,ri)": [22, 30], "abs.w": [20, 28], "abs.l": [24, 32]
    },
    "abs.l": {
      "dn": [16, 20], "an": [16, 20], "(an)": [20, 28], "(an)+": [20, 28], "-(an)": [20, 28],
      "d(an)": [24, 32], "d(an,ri)": [26, 34], "abs.w": [24, 32], "abs.l": [28, 36]
    },
    "d(pc)": {
      "dn": [12, 16], "an": [12, 16], "(an)": [16, 24], "(an)+": [16, 24], "-(an)": [16, 24],
      "d(an)": [20, 28], "d(an,ri)": [22, 30], "abs.w": [20, 28], "abs.l": [24, 32]
    },
    "d(pc,ri)": {
      "dn": [14, 18], "an": [14, 18], "(an)": [18, 26], "(an)+": [18, 26], "-(an)": [18, 26],
      "d(an)": [22, 30], "d(an,ri)": [24, 32], "abs.w": [22, 30], "abs.l": [26, 34]
    },
    "imm": {
      "dn": [8, 12], "an": [8, 12], "(an)": [12, 20], "(an)+": [12, 20], "-(an)": [12, 20],
      "d(an)": [16, 24], "d(an,ri)": [18, 26], "abs.w": [16, 24], "abs.l": [20, 28]
    }
  },

  "ea_calc": {
    "_comment": "EA calculation time to add for memory operands: [b/w, l]",
    "(an)": [4, 8],
    "(an)+": [4, 8],
    "-(an)": [6, 10],
    "d(an)": [8, 12],
    "d(an,ri)": [10, 14],
    "abs.w": [8, 12],
    "abs.l": [12, 16],
    "d(pc)": [8, 12],
    "d(pc,ri)": [10, 14],
    "imm": [4, 8]
  },

  "standard": {
    "_comment": "Standard ALU ops. Format: {ea_an: [b/w, l], ea_dn: [b/w, l], dn_mem: [b/w, l]}",
    "add":  {"ea_an": [8, 8], "ea_dn": [4, 8], "dn_mem": [8, 12]},
    "adda": {"ea_an": [8, 8]},
    "and":  {"ea_dn": [4, 8], "dn_mem": [8, 12]},
    "cmp":  {"ea_an": [6, 6], "ea_dn": [4, 6]},
    "cmpa": {"ea_an": [6, 6]},
    "eor":  {"ea_dn": [4, 8], "dn_mem": [8, 12]},
    "or":   {"ea_dn": [4, 8], "dn_mem": [8, 12]},
    "sub":  {"ea_an": [8, 8], "ea_dn": [4, 8], "dn_mem": [8, 12]},
    "suba": {"ea_an": [8, 8]},
    "divs": {"ea_dn": [158, 158]},
    "divu": {"ea_dn": [140, 140]},
    "muls": {"ea_dn": [70, 70]},
    "mulu": {"ea_dn": [70, 70]}
  },

  "immediate": {
    "_comment": "Immediate instructions: {dn: [b/w, l], an: [b/w, l], mem: [b/w, l]}",
    "addi": {"dn": [8, 16], "mem": [12, 20]},
    "addq": {"dn": [4, 8], "an": [8, 8], "mem": [8, 12]},
    "andi": {"dn": [8, 16], "mem": [12, 20]},
    "cmpi": {"dn": [8, 14], "an": [8, 14], "mem": [8, 12]},
    "eori": {"dn": [8, 16], "mem": [12, 20]},
    "moveq": {"dn": [4, 4]},
    "ori":  {"dn": [8, 16], "mem": [12, 20]},
    "subi": {"dn": [8, 16], "mem": [12, 20]},
    "subq": {"dn": [4, 8], "an": [8, 8], "mem": [8, 12]},
    "clr":  {"dn": [4, 6], "an": [4, 6], "mem": [8, 12]},
    "neg":  {"dn": [4, 6], "an": [4, 6], "mem": [8, 12]},
    "negx": {"dn": [4, 6], "an": [4, 6], "mem": [8, 12]},
    "not":  {"dn": [4, 6], "an": [4, 6], "mem": [8, 12]},
    "nbcd": {"dn": [6, 6], "mem": [8, 8]},
    "scc":  {"dn": [4, 6], "mem": [8, 8]},
