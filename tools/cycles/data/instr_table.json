  "shift": {
    "_comment": "Shift/rotate: base time + 2 × shift_count for register. [b/w, l] for reg, single for mem",
    "asl":  {"reg": [6, 8], "mem": 8},
    "asr":  {"reg": [6, 8], "mem": 8},
    "lsl":  {"reg": [6, 8], "mem": 8},
    "lsr":  {"reg": [6, 8], "mem": 8},
    "rol":  {"reg": [6, 8], "mem": 8},
    "ror":  {"reg": [6, 8], "mem": 8},
    "roxl": {"reg": [6, 8], "mem": 8},
    "roxr": {"reg": [6, 8], "mem": 8}
  },

  "control": {
    "_comment": "Control flow by EA mode",
    "jmp": {
      "(an)": 8, "d(an)": 10, "d(an,ri)": 14, "abs.w": 10, "abs.l": 12, "d(pc)": 10, "d(pc,ri)": 14
    },
    "jsr": {
      "(an)": 16, "d(an)": 18, "d(an,ri)": 22, "abs.w": 18, "abs.l": 20, "d(pc)": 18, "d(pc,ri)": 22
    },
    "lea": {
      "(an)": 4, "d(an)": 8, "d(an,ri)": 12, "abs.w": 8, "abs.l": 12, "d(pc)": 8, "d(pc,ri)": 12
    },
    "pea": {
      "(an)": 12, "d(an)": 16, "d(an,ri)": 20, "abs.w": 16, "abs.l": 20, "d(pc)": 16, "d(pc,ri)": 20
    }
  },

  "movem": {
    "_comment": "MOVEM base times by EA mode. Add 4×n for .w or 8×n for .l where n=register count",
    "mem_to_reg": {
      "(an)": 12, "(an)+": 12, "d(an)": 16, "d(an,ri)": 18, "abs.w": 16, "abs.l": 20, "d(pc)": 16, "d(pc,ri)": 18
    },
    "reg_to_mem": {
      "(an)": 8, "-(an)": 8, "d(an)": 12, "d(an,ri)": 14, "abs.w": 12, "abs.l": 16
    }
  },

  "bit": {
    "_comment": "Bit instructions. reg_l is .l on register, mem_b is .b on memory",
    "bchg": {"reg": [8, 12], "mem": [8, 12]},
    "bclr": {"reg": [10, 14], "mem": [8, 12]},
    "bset": {"reg": [8, 12], "mem": [8, 12]},
